# File MẪU: chỉ ghi tên biến, KHÔNG ghi giá trị thật.
# Cách dùng: copy file này thành .env.local rồi điền giá trị thật vào .env.local
# (.env.local đã được git bỏ qua, không bị đưa lên GitHub).

# Sanity (công thức món ăn)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Supabase (lưu thực đơn)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Token GHI của Sanity — CHỈ dùng cho script nhập dữ liệu (npm run import:recipes).
# BÍ MẬT: không đặt tiền tố NEXT_PUBLIC_, không đưa lên Vercel, không commit.
SANITY_API_WRITE_TOKEN=
